# LinkedIn Developer App credentials. Never commit real values.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8787/callback
# Optional override for the LinkedIn REST API version.
LINKEDIN_VERSION=202608

# --- Remote (Docker/EC2) deployment only — see docs/DEPLOY.md ---
# Public hostname the server is reached at, e.g. linkedin-mcp.203-0-113-10.sslip.io
MCP_DOMAIN=
# Shared secret MCP clients must send as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
